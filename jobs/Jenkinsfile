pipeline {
    agent any
    tools {
        maven 'maven'
        jdk 'JDK 17'
    }
    options {
        // This is required if you want to clean before build
        skipDefaultCheckout(true)
        
        // Set a timeout for the entire pipeline
        timeout(time: 30, unit: 'MINUTES')

        // Only keep 5 jobs history and 2 jobs artifacts
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '2'))
    }
    parameters {
        string(name: 'LS_URL', defaultValue: '', description: 'Parasoft LS URL')
        string(name: 'CTP_URL', defaultValue: '', description: 'Parasoft CTP URL')
        string(name: 'DTP_URL', defaultValue: '', description: 'Parasoft DTP URL')
        string(name: 'DTP_USER', defaultValue: 'demo', description: 'Parasoft DTP Username')
        password(name: 'DTP_PASS', defaultValue: '', description: 'Parasoft DTP Password')
        string(name: 'BUILD_ID', defaultValue: 'baseline', description: 'The build Id of the project in DTP and CTP')
        string(name: 'CTP_SYSTEM_NAME', defaultValue: 'Spring PetClinic', description: 'CTP system name')
        string(name: 'CTP_ENV_NAME', defaultValue: 'QA', description: 'CTP environment name')
        string(name: 'CTP_DEBUG', defaultValue: 'false', description: 'Enable debug logging for Jenkins pipeline')
    }
    environment {
        // App Details
        app_name = 'spring-petclinic-microservices' // top level DTP Project

        // Parasoft Settings
        jtestUTConfig="jtest.builtin://Unit Tests"
        jtestSAConfig="jtest.builtin://Recommended Rules"

        // Dynamic configs
        BUILD_TIMESTAMP = "${BUILD_ID}"
    }

    stages {
        stage('Set Up') {
            steps {
                // Clean workspace before build
                cleanWs()
                // Checkout project
                checkout scm
                
                // Resolve instance metadata: UID, GID, public and private IP
                script {
                    env.UID = sh(script: 'id -u jenkins', returnStdout: true).trim()
                    env.GID = sh(script: 'id -g jenkins', returnStdout: true).trim()
                    env.PUBLIC_IP = sh(script: 'curl -s http://checkip.amazonaws.com', returnStdout: true).trim()
                    env.PRIVATE_IP = sh(script: '''
                        TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)
                        if [ -n "$TOKEN" ]; then
                            curl -sH "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4
                        else
                            curl -s http://169.254.169.254/latest/meta-data/local-ipv4
                        fi
                    ''', returnStdout: true).trim()
                    if (!env.PRIVATE_IP) {
                        error('Failed to resolve PRIVATE_IP from EC2 metadata service.')
                    }
                }

                // Normalize URLs and resolve CTP environment ID
                script {
                    def systemName        = params.CTP_SYSTEM_NAME
                    def envName           = params.CTP_ENV_NAME
                    def encodedSystemName = java.net.URLEncoder.encode(systemName, 'UTF-8')
                    def encodedEnvName    = java.net.URLEncoder.encode(envName, 'UTF-8')
                    def ctpUrl = params.CTP_URL.replaceAll('/+$', '')
                    def dtpUrl = params.DTP_URL.replaceAll('/+$', '')
                    env.CTP_URL = ctpUrl
                    env.DTP_URL = dtpUrl

                    withEnv(["CTP_URL=${ctpUrl}", "ENCODED_SYSTEM=${encodedSystemName}", "ENCODED_ENV=${encodedEnvName}"]) {
                        
                        // Retrieve systemId from CTP based on system name
                        def systemResponse = sh(
                            script: '''
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set +x
                                fi
                                curl -sk -u "${DTP_USER}:${DTP_PASS}" \
                                    "${CTP_URL}/em/api/v3/systems?name=${ENCODED_SYSTEM}&limit=50&offset=0"
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set -x
                                fi
                            ''',
                            returnStdout: true
                        ).trim()
                        if (params.CTP_DEBUG == 'true') {
                            echo "CTP systems response:\n${systemResponse}"
                        }
                        def systemJson = new groovy.json.JsonSlurperClassic().parseText(systemResponse)
                        def systemId = systemJson.systems?.find { it.name == systemName }?.id
                        if (!systemId) {
                            error("Failed to resolve systemId for system '${systemName}'.")
                        }

                        // Retrieve envId from CTP based on environment name and systemId
                        def envResponse = sh(
                            script: '''
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set +x
                                fi
                                curl -sk -u "${DTP_USER}:${DTP_PASS}" \
                                    "${CTP_URL}/em/api/v3/environments?name=${ENCODED_ENV}&limit=50&offset=0"
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set -x
                                fi
                            ''',
                            returnStdout: true
                        ).trim()
                        if (params.CTP_DEBUG == 'true') {
                            echo "CTP environments response:\n${envResponse}"
                        }
                        def envJson = new groovy.json.JsonSlurperClassic().parseText(envResponse)
                        def resolvedEnvId = envJson.environments?.find { it.name == envName && it.systemId == systemId }?.id
                        if (!resolvedEnvId) {
                            error("Failed to resolve envId for environment '${envName}' and systemId '${systemId}'.")
                        }
                        env.CTP_ENV_ID = resolvedEnvId.toString()
                    }
                }
                
                // startup Selenium Grid
                sh '''
                    # Start Selenium Grid for Selenium test execution
                    docker run -d --rm \
                    -p 4444:4444 \
                    -p 7900:7900 \
                    --network=demo-net \
                    --shm-size "2g" \
                    -e SE_NODE_MAX_SESSIONS=2 \
                    -e SE_NODE_OVERRIDE_MAX_SESSIONS=true \
                    --name selenium-grid \
                    selenium/standalone-chrome:latest
                    '''
                // Set up Parasoft License
                sh '''
                    if [ "${CTP_DEBUG}" != "true" ]; then
                        set +x
                    fi
                    cat > ./jtest/jtestcli.properties << EOF
parasoft.eula.accepted=true

jtest.license.use_network=true
jtest.license.network.edition=server_edition

license.network.use.specified.server=true
license.network.auth.enabled=true
license.network.url=${LS_URL}
license.network.user=${DTP_USER}
license.network.password=${DTP_PASS}

dtp.url=${DTP_URL}
dtp.user=${DTP_USER}
dtp.password=${DTP_PASS}

scontrol.git.exec=git
scontrol.rep1.git.branch=${GIT_BRANCH#origin/}
scontrol.rep1.git.url=${GIT_URL}
scontrol.rep1.type=git

report.scontrol=min
report.coverage.line.hashes=true
report.dtp.publish=true

console.verbosity.level=high
EOF
                    if [ "${CTP_DEBUG}" = "true" ]; then
                        echo "--- jtestcli.properties ---"
                        cat ./jtest/jtestcli.properties
                    fi
                    if [ "${CTP_DEBUG}" != "true" ]; then
                        set -x
                    fi
                    '''
            }
        }
        stage('Build: Create Docker Images') {
            when { equals expected: true, actual: true }
            steps {
                // build the binaries
                echo "Building ${env.JOB_NAME}..."
                sh  '''
                    # Build the Maven package
                    ./mvnw clean install -P buildDocker -DskipTests=true
                    '''
            }
        }
        stage('Build: Jtest UT + Static Cov') {
            when { equals expected: true, actual: true }
            steps {
                // Run Jtest Unit test with CC
                script {
                        // Setup stage-specific additional settings
                        sh '''
                            if [ "${CTP_DEBUG}" != "true" ]; then
                                set +x
                            fi
                            cat > ./jtest/jtestcli-sa.properties << EOF
dtp.project=${app_name}
build.id=${app_name}-${BUILD_TIMESTAMP}
EOF
                            if [ "${CTP_DEBUG}" = "true" ]; then
                                echo "--- jtestcli-sa.properties ---"
                                cat ./jtest/jtestcli-sa.properties
                            fi
                            if [ "${CTP_DEBUG}" != "true" ]; then
                                set -x
                            fi
                        '''
                        sh '''
                            if [ "${CTP_DEBUG}" != "true" ]; then
                                set +x
                            fi
                            cat > ./jtest/jtestcli-ut.properties << EOF
dtp.project=${app_name}
build.id=${app_name}-${BUILD_TIMESTAMP}
report.coverage.images=${app_name};${app_name}-UT
report.coverage.static.images=${app_name};${app_name}-UT;${app_name}-FT
EOF
                            if [ "${CTP_DEBUG}" = "true" ]; then
                                echo "--- jtestcli-ut.properties ---"
                                cat ./jtest/jtestcli-ut.properties
                            fi
                            if [ "${CTP_DEBUG}" != "true" ]; then
                                set -x
                            fi
                        '''
                        sh '''
                            if [ "${CTP_DEBUG}" != "true" ]; then
                                set +x
                            fi
                            cat > ./jtest/jtestcli-ft.properties << EOF
dtp.project=${app_name}
build.id=${app_name}-${BUILD_TIMESTAMP}
report.coverage.images=${app_name};${app_name}-FT
EOF
                            if [ "${CTP_DEBUG}" = "true" ]; then
                                echo "--- jtestcli-ft.properties ---"
                                cat ./jtest/jtestcli-ft.properties
                            fi
                            if [ "${CTP_DEBUG}" != "true" ]; then
                                set -x
                            fi
                        '''
                        // Execute the build with Jtest Maven plugin in docker
                        sh '''
                            # Run Maven build with Jtest tasks via Docker
                            docker run \
                            -u ${UID}:${GID} \
                            --rm -i \
                            --name jtest \
                            --network=demo-net \
                            -v "$PWD:$PWD" \
                            -w "$PWD" \
                            $(docker build --build-arg HOST_UID="$UID" --build-arg HOST_GID="$GID" -q ./jtest) /bin/bash -c " \
                            
                            # Compile the project and run Jtest Static Analysis
                            mvn -ntp test-compile \
                            jtest:jtest \
                            -DskipTests=true \
                            -s './jtest/.m2/settings.xml' \
                            -Djtest.settingsList='./jtest/jtestcli.properties,./jtest/jtestcli-sa.properties' \
                            -Djtest.config='${jtestSAConfig}' \
                            -Djtest.report=./target/jtest/sa \
                            -Djtest.showSettings=true; \

                            # Compile the test sources and run unit tests with Jtest, publishing static coverage for functional testing as well
                            mvn -ntp jtest:agent \
                            test \
                            jtest:jtest \
                            -s './jtest/.m2/settings.xml' \
                            -Dmaven.test.failure.ignore=true \
                            -Djtest.settingsList='./jtest/jtestcli.properties,./jtest/jtestcli-ut.properties' \
                            -Djtest.config='${jtestUTConfig}' \
                            -Djtest.report=./target/jtest/ut \
                            -Djtest.showSettings=true; \
                            "
                        '''
                }
                // Parasoft Findings plugin for Unit Tests Results
                echo '---> Parsing 10.x unit test reports'
                script {
                    step([$class: 'XUnitPublisher', 
                        // thresholds: [failed(
                        //     failureNewThreshold: '0', 
                        //     failureThreshold: '0')
                        // ],
                        tools: [[$class: 'ParasoftType', 
                            deleteOutputFiles: true, 
                            failIfNotNew: false, 
                            pattern: '**/target/jtest/ut/*report*.xml', 
                            skipNoTestFiles: true, 
                            stopProcessingIfError: false
                        ]]
                    ])
                }
            }
        }
        stage('Deploy: Docker Compose + CTP') {
            when { equals expected: true, actual: true }
            steps {
                build job: 'Petclinic-deploy', parameters: [
                    string(name: 'CTP_URL', value: env.CTP_URL),
                    string(name: 'DTP_URL', value: env.DTP_URL),
                    string(name: 'DTP_USER', value: params.DTP_USER),
                    password(name: 'DTP_PASS', value: params.DTP_PASS),
                    string(name: 'BUILD_TIMESTAMP', value: env.BUILD_TIMESTAMP),
                    string(name: 'CTP_ENV_ID', value: env.CTP_ENV_ID),
                    string(name: 'CTP_DEBUG', value: params.CTP_DEBUG),
                ]
            }
        }
        stage('Test: Full Selenium Suites') {
            when { equals expected: true, actual: true}
            steps {
                withEnv(["CTP_URL=${env.CTP_URL}", "CTP_LOG_LEVEL=${params.CTP_DEBUG == 'true' ? 'DEBUG' : 'INFO'}"]) {
                    sh '''
                        echo "Running Selenium JUnit 5 module with Selenium Grid, parallel execution, and publishing to DTP/CTP..."
                        if [ "${CTP_DEBUG}" != "true" ]; then
                            set +x
                        fi
                        mvn -ntp verify \
                        -pl spring-petclinic-selenium-tests \
                        -Djunit.jupiter.execution.parallel.enabled=true \
                        -Djunit.jupiter.execution.parallel.mode.classes.default=concurrent \
                        -am \
                        -DPETCLINIC_URL="http://$PUBLIC_IP:8099" \
                        -DCTP_BASE_URL="$CTP_URL" \
                        -DCTP_ENV_ID=$CTP_ENV_ID \
                        -DCTP_USERNAME=$DTP_USER \
                        -DCTP_PASSWORD=$DTP_PASS \
                        -DCTP_PUBLISH_BASELINE=false \
                        -DCTP_BASELINE_BUILD_ID=${app_name}-${BUILD_TIMESTAMP} \
                        -DPROXY_HOST=$PRIVATE_IP \
                        -DPROXY_BIND_HOST=$PRIVATE_IP \
                        -DCTP_LOG_LEVEL=${CTP_LOG_LEVEL} \
                        '''
                    sh '''
                        echo "Running Selenium JUnit5 + Cucumber module with Selenium Grid, sequential execution, and publishing to DTP/CTP..."
                        if [ "${CTP_DEBUG}" != "true" ]; then
                            set +x
                        fi
                        mvn -ntp verify \
                        -pl spring-petclinic-selenium-cucumber-tests \
                        -am \
                        -DPETCLINIC_URL="http://$PUBLIC_IP:8099" \
                        -DCTP_BASE_URL="$CTP_URL" \
                        -DCTP_ENV_ID=$CTP_ENV_ID \
                        -DCTP_USERNAME=$DTP_USER \
                        -DCTP_PASSWORD=$DTP_PASS \
                        -DCTP_PUBLISH_BASELINE=false \
                        -DCTP_BASELINE_BUILD_ID=${app_name}-${BUILD_TIMESTAMP} \
                        -DPROXY_HOST=$PRIVATE_IP \
                        -DPROXY_BIND_HOST=$PRIVATE_IP \
                        -DCTP_LOG_LEVEL=${CTP_LOG_LEVEL} \
                        '''
                    sh '''
                        echo "Running Selenium TestNG module with Selenium Grid, parallel execution, and publishing to DTP/CTP..."
                        if [ "${CTP_DEBUG}" != "true" ]; then
                            set +x
                        fi
                        mvn -ntp verify \
                        -pl spring-petclinic-selenium-testng-tests \
                        -am \
                        -DPETCLINIC_URL="http://$PUBLIC_IP:8099" \
                        -DCTP_BASE_URL="$CTP_URL" \
                        -DCTP_ENV_ID=$CTP_ENV_ID \
                        -DCTP_USERNAME=$DTP_USER \
                        -DCTP_PASSWORD=$DTP_PASS \
                        -DCTP_PUBLISH_BASELINE=false \
                        -DCTP_BASELINE_BUILD_ID=${app_name}-${BUILD_TIMESTAMP} \
                        -DPROXY_HOST=$PRIVATE_IP \
                        -DPROXY_BIND_HOST=$PRIVATE_IP \
                        -DCTP_LOG_LEVEL=${CTP_LOG_LEVEL} \
                        '''
                    sh '''
                        echo "Running Playwright JUnit 5 module, parallel execution, and publishing to DTP/CTP..."
                        if [ "${CTP_DEBUG}" != "true" ]; then
                            set +x
                        fi
                        mvn -ntp verify \
                        -pl spring-petclinic-playwright-tests \
                        -am \
                        -Djunit.jupiter.execution.parallel.enabled=true \
                        -Djunit.jupiter.execution.parallel.mode.classes.default=concurrent \
                        -DHEADLESS=true \
                        -DPETCLINIC_URL="http://$PUBLIC_IP:8099" \
                        -DCTP_BASE_URL="$CTP_URL" \
                        -DCTP_ENV_ID=$CTP_ENV_ID \
                        -DCTP_USERNAME=$DTP_USER \
                        -DCTP_PASSWORD=$DTP_PASS \
                        -DCTP_PUBLISH_BASELINE=true \
                        -DCTP_BASELINE_BUILD_ID=${app_name}-${BUILD_TIMESTAMP} \
                        -DPROXY_HOST=$PRIVATE_IP \
                        -DPROXY_BIND_HOST=$PRIVATE_IP \
                        -DCTP_LOG_LEVEL=${CTP_LOG_LEVEL} \
                        '''
                }
            }
        }
        stage('Release') {
            steps {
                sh 'echo "Release"'
            }
        }
    }
    post {
        // archive jtest Artifacts after success
        success {
            archiveArtifacts artifacts: 'target/jtest/ut/*', excludes: 'target/ut/.jtest/cache', followSymlinks: false
        }
        // Clean after build
        always {
            sh '''
                if [ "${CTP_DEBUG}" = "true" ]; then
                    echo "--- selenium-grid logs (CTP_DEBUG=true) ---"
                    docker logs selenium-grid || true
                fi
                docker container stop selenium-grid || true
                docker container prune -f
                docker image prune -f
                echo "cleaning up..."
                # rm -rf "jtest_agent"
                # rm -rf "jtestcov"
            '''
        }
    }
}