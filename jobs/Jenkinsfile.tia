pipeline {
    agent any
    tools {
        maven 'maven'
        jdk 'JDK 17'
    }
    options {
        // This is required if you want to clean before build
        skipDefaultCheckout(true)

        // Set a timeout for the entire pipeline
        timeout(time: 20, unit: 'MINUTES')

        // Only keep 5 jobs history and 2 jobs artifacts
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '2'))
    }
    parameters {
        // Parasoft CTP / DTP endpoints (per-run configurable)
        string(name: 'CTP_URL', defaultValue: '', description: 'Parasoft CTP URL')
        string(name: 'DTP_URL', defaultValue: '', description: 'Parasoft DTP URL')

        // Publish Parasoft analysis + coverage results to DTP
        booleanParam(name: 'DTP_PUBLISH', defaultValue: false, description: 'Publish Parasoft analysis + coverage results to DTP')

        // Optional buildId override; leave blank to use the default value 'baseline-tia'
        string(name: 'BUILD_ID_OVERRIDE', defaultValue: '', description: 'Optional buildId override (leave blank to use the default value \'baseline-tia\')')

        // CTP System / Environment
        string(name: 'CTP_SYSTEM_NAME', defaultValue: 'Spring PetClinic', description: 'CTP system name')
        string(name: 'CTP_ENV_NAME', defaultValue: 'QA', description: 'CTP environment name')

        // CI debug toggle: enables shell trace (set -x) + echoes generated .properties files to the console
        booleanParam(name: 'CI_DEBUG', defaultValue: false, description: 'Enable verbose CI debug logging (shell trace + properties-file echo)')

        // Parasoft License Server URL is sourced from the Jenkins global env var DEFAULT_LSS_URL.
        // Parasoft user/password is sourced from the Jenkins credential 'parasoft-demo-user'.
    }
    environment {
        // App Details
        app_name = 'spring-petclinic-microservices' // top level DTP Project

        // Parasoft Settings
        jtestUTConfig = 'jtest.builtin://Unit Tests'
        jtestSAConfig = 'jtest.builtin://Recommended Rules'

        // Parasoft License Server URL (sourced from Jenkins global env var DEFAULT_LSS_URL)
        LS_URL = "${env.DEFAULT_LSS_URL ?: ''}"
    }

    stages {
        stage('Set Up') {
            steps {
                // Clean workspace before build
                cleanWs()
                // Checkout project
                script {
                    def scmVars = checkout scm
                    env.GIT_BRANCH = scmVars.GIT_BRANCH?.replaceFirst('^origin/', '') ?: ''
                    env.GIT_URL    = scmVars.GIT_URL ?: ''
                }

                // Normalize URL values (strip trailing slashes) and export toggles for shell steps
                script {
                    env.LS_URL      = (env.LS_URL     ?: '').replaceAll('/+$', '')
                    env.CTP_URL     = (params.CTP_URL ?: '').replaceAll('/+$', '')
                    env.DTP_URL     = (params.DTP_URL ?: '').replaceAll('/+$', '')
                    env.DTP_PUBLISH = params.DTP_PUBLISH.toString()
                    env.CI_DEBUG    = params.CI_DEBUG.toString()
                    // Selenic/Playwright tests: coverage-integration library uses SLF4J; slf4j-simple
                    // backend is on the test classpath. Raise its log level to `debug` under CI_DEBUG.
                    env.CI_LIB_LOG_LEVEL = params.CI_DEBUG ? 'debug' : 'info'

                    // Resolve buildId: BUILD_ID_OVERRIDE param wins, otherwise fall back to 'baseline-tia'.
                    if (params.BUILD_ID_OVERRIDE?.trim()) {
                        env.buildId = params.BUILD_ID_OVERRIDE.trim()
                        echo "Using BUILD_ID_OVERRIDE parameter: ${env.buildId}"
                    } else {
                        env.buildId = 'baseline-tia'
                        echo "Using default buildId: ${env.buildId}"
                    }
                }

                // Resolve BASELINE_ID from the last successful Petclinic-baseline run's BUILD_ID_OVERRIDE param.
                // This must match the baselineId the Petclinic-baseline pipeline POSTs to CTP in its
                // "Publish: CTP Baseline for TIA" stage:
                //   POST /em/api/v3/environments/{envId}/coverage/baselines/${app_name}-${buildId}
                // NOTE: requires one-time In-process Script Approval in Manage Jenkins → Script Approval
                script {
                    def baselineJob  = Jenkins.instance.getItemByFullName('Petclinic-baseline')
                    def lastBuild    = baselineJob?.getLastSuccessfulBuild()
                    def overrideVal  = lastBuild?.getAction(hudson.model.ParametersAction.class)
                                           ?.getParameter('BUILD_ID_OVERRIDE')
                                           ?.getValue()
                    def baselineBuildId = (overrideVal?.trim()) ? overrideVal.trim() : 'baseline'
                    env.BASELINE_ID  = "${app_name}-${baselineBuildId}"
                    echo "Resolved BASELINE_ID: ${env.BASELINE_ID}"
                }

                // Resolve instance metadata: UID, GID, public and private IP
                script {
                    env.UID = sh(script: 'id -u jenkins', returnStdout: true).trim()
                    env.GID = sh(script: 'id -g jenkins', returnStdout: true).trim()
                    env.PUBLIC_IP = sh(script: 'curl -s http://checkip.amazonaws.com', returnStdout: true).trim()
                    env.PRIVATE_IP = sh(script: '''
                        TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600" || true)
                        if [ -n "$TOKEN" ]; then
                            curl -sH "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4
                        else
                            curl -s http://169.254.169.254/latest/meta-data/local-ipv4
                        fi
                    ''', returnStdout: true).trim()
                    if (!env.PRIVATE_IP) {
                        error('Failed to resolve PRIVATE_IP from EC2 metadata service.')
                    }
                }

                // Resolve CTP environment ID
                script {
                    def systemName        = params.CTP_SYSTEM_NAME
                    def envName           = params.CTP_ENV_NAME
                    def encodedSystemName = java.net.URLEncoder.encode(systemName, 'UTF-8')
                    def encodedEnvName    = java.net.URLEncoder.encode(envName, 'UTF-8')

                    withCredentials([
                        usernamePassword(credentialsId: 'parasoft-demo-user', usernameVariable: 'PARASOFT_USER', passwordVariable: 'PARASOFT_PASS')
                    ]) {
                        withEnv(["ENCODED_SYSTEM=${encodedSystemName}", "ENCODED_ENV=${encodedEnvName}"]) {
                            // Retrieve systemId from CTP based on system name
                            def systemResponse = sh(
                                script: '''
                                    if [ "${CI_DEBUG}" != "true" ]; then set +x; fi
                                    curl -sk -u "${PARASOFT_USER}:${PARASOFT_PASS}" \
                                        "${CTP_URL}/em/api/v3/systems?name=${ENCODED_SYSTEM}&limit=50&offset=0"
                                ''',
                                returnStdout: true
                            ).trim()
                            if (params.CI_DEBUG) {
                                echo "CTP systems response:\n${systemResponse}"
                            }
                            def systemJson = new groovy.json.JsonSlurperClassic().parseText(systemResponse)
                            def systemId = systemJson.systems?.find { it.name == systemName }?.id
                            if (!systemId) {
                                error("Failed to resolve systemId for system '${systemName}'.")
                            }

                            // Retrieve envId from CTP based on environment name and systemId
                            def envResponse = sh(
                                script: '''
                                    if [ "${CI_DEBUG}" != "true" ]; then set +x; fi
                                    curl -sk -u "${PARASOFT_USER}:${PARASOFT_PASS}" \
                                        "${CTP_URL}/em/api/v3/environments?name=${ENCODED_ENV}&limit=50&offset=0"
                                ''',
                                returnStdout: true
                            ).trim()
                            if (params.CI_DEBUG) {
                                echo "CTP environments response:\n${envResponse}"
                            }
                            def envJson = new groovy.json.JsonSlurperClassic().parseText(envResponse)
                            def resolvedEnvId = envJson.environments?.find { it.name == envName && it.systemId == systemId }?.id
                            if (!resolvedEnvId) {
                                error("Failed to resolve envId for environment '${envName}' and systemId '${systemId}'.")
                            }
                            env.CTP_ENV_ID = resolvedEnvId.toString()
                        }
                    }
                }

                // startup Selenium Grid
                sh '''
                    # Start Selenium Grid for Selenium test execution
                    docker run -d --rm \
                    -p 4444:4444 \
                    -p 7900:7900 \
                    --network=demo-net \
                    --shm-size "2g" \
                    -e SE_NODE_MAX_SESSIONS=2 \
                    -e SE_NODE_OVERRIDE_MAX_SESSIONS=true \
                    --name selenium-grid \
                    selenium/standalone-chrome:latest
                    '''

                // Emit jtestcli.properties (secrets injected via withCredentials; content echoed only when CI_DEBUG=true)
                withCredentials([
                    usernamePassword(credentialsId: 'parasoft-demo-user', usernameVariable: 'PARASOFT_USER', passwordVariable: 'PARASOFT_PASS')
                ]) {
                    sh '''
                        if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                        cat > ./jtest/jtestcli.properties << EOF
parasoft.eula.accepted=true

jtest.license.use_network=true
jtest.license.network.edition=server_edition

license.network.use.specified.server=true
license.network.auth.enabled=true
license.network.url=${LS_URL}
license.network.user=${PARASOFT_USER}
license.network.password=${PARASOFT_PASS}

dtp.url=${DTP_URL}
dtp.user=${PARASOFT_USER}
dtp.password=${PARASOFT_PASS}

scontrol.git.exec=git
scontrol.rep1.git.branch=${GIT_BRANCH}
scontrol.rep1.git.url=${GIT_URL}
scontrol.rep1.type=git

report.scontrol=min
report.coverage.line.hashes=true
report.dtp.publish=${DTP_PUBLISH}

console.verbosity.level=high
EOF
                        if [ "${CI_DEBUG}" = "true" ]; then
                            echo "--- jtestcli.properties ---"
                            cat ./jtest/jtestcli.properties
                        fi
                    '''
                }

                // copy artifacts from latest successful baseline
                copyArtifacts projectName: 'Petclinic-baseline', selector: lastSuccessful(), target: './baseline-artifacts'
            }
        }
        stage('Build: Create Docker Images') {
            when { equals expected: true, actual: true }
            steps {
                // build the binaries
                echo "Building ${env.JOB_NAME}..."
                sh  '''

                    # Build the Maven package
                    ./mvnw clean install -P buildDocker -DskipTests=true \
                    -s './jtest/.m2/settings.xml'
                    '''
            }
        }
        stage('Build: Jtest UT + Static Cov') {
            when { equals expected: true, actual: true }
            steps {
                // Run Jtest Unit test with CC
                script {
                        // Setup stage-specific additional settings
                        sh '''
                            if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                            cat > ./jtest/jtestcli-sa.properties << EOF
dtp.project=${app_name}
build.id=${app_name}-${buildId}
EOF
                            if [ "${CI_DEBUG}" = "true" ]; then
                                echo "--- jtestcli-sa.properties ---"
                                cat ./jtest/jtestcli-sa.properties
                            fi
                        '''
                        sh '''
                            if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                            cat > ./jtest/jtestcli-ut.properties << EOF
dtp.project=${app_name}
build.id=${app_name}-${buildId}
report.coverage.images=${app_name};${app_name}-UT
report.coverage.static.images=${app_name};${app_name}-UT;${app_name}-FT
EOF
                            if [ "${CI_DEBUG}" = "true" ]; then
                                echo "--- jtestcli-ut.properties ---"
                                cat ./jtest/jtestcli-ut.properties
                            fi
                        '''
                        sh '''
                            if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                            cat > ./jtest/jtestcli-ft.properties << EOF
dtp.project=${app_name}
build.id=${app_name}-${buildId}
report.coverage.images=${app_name};${app_name}-FT
EOF
                            if [ "${CI_DEBUG}" = "true" ]; then
                                echo "--- jtestcli-ft.properties ---"
                                cat ./jtest/jtestcli-ft.properties
                            fi
                        '''
                        // Execute the build with Jtest Maven plugin in docker
                        sh '''
                            # Run Maven build with Jtest tasks via Docker
                            docker run \
                            -u ${UID}:${GID} \
                            --rm -i \
                            --name jtest \
                            --network=demo-net \
                            -v "$PWD:$PWD" \
                            -w "$PWD" \
                            $(docker build --build-arg HOST_UID="$UID" --build-arg HOST_GID="$GID" -q ./jtest) /bin/bash -c " \

                            # Compile the project and run Jtest Static Analysis
                            mvn -ntp \
                            test-compile jtest:jtest \
                            -DskipTests=true \
                            -s './jtest/.m2/settings.xml' \
                            -Djtest.settingsList='./jtest/jtestcli.properties,./jtest/jtestcli-sa.properties' \
                            -Djtest.config='${jtestSAConfig}' \
                            -Djtest.report=./target/jtest/sa \
                            -Djtest.showSettings=true; \

                            # Compile the test sources and run unit tests with Jtest
                            mvn -ntp \
                            tia:affected-tests jtest:agent test jtest:jtest \
                            -s './jtest/.m2/settings.xml' \
                            -Dmaven.test.failure.ignore=true \
                            -Djtest.settingsList='./jtest/jtestcli.properties,./jtest/jtestcli-ut.properties' \
                            -Djtest.config='${jtestUTConfig}' \
                            -Djtest.referenceCoverageFile=./baseline-artifacts/target/jtest/ut/coverage.xml \
                            -Djtest.referenceReportFile=./baseline-artifacts/target/jtest/ut/report.xml \
                            -Dparasoft.runModifiedTests=true \
                            -Djtest.report=./target/jtest/ut \
                            -Djtest.showSettings=true;

                            # Package the application with the Jtest Monitor
                            mvn -ntp clean install jtest:monitor \
                            -s './jtest/.m2/settings.xml' \
                            -DskipTests=true \
                            -Djtest.settingsList='./jtest/jtestcli.properties,./jtest/jtestcli-ut.properties' \
                            -Djtest.showSettings=true \
                            -Dproperty.report.dtp.publish=true
                            "
                        '''
                }
                // Parasoft Findings plugin for Unit Tests Results
                echo '---> Parsing 10.x unit test reports'
                script {
                    step([$class: 'XUnitPublisher',
                        // thresholds: [failed(
                        //     failureNewThreshold: '0',
                        //     failureThreshold: '0')
                        // ],
                        tools: [[$class: 'ParasoftType',
                            deleteOutputFiles: true,
                            failIfNotNew: false,
                            pattern: '**/target/jtest/ut/*report*.xml',
                            skipNoTestFiles: true,
                            stopProcessingIfError: false
                        ]]
                    ])
                }
            }
        }
        stage('Deploy: Docker Compose + CTP') {
            when { equals expected: true, actual: true }
            steps {
                build job: 'Petclinic-deploy', parameters: [
                    string(name: 'CTP_URL', value: env.CTP_URL),
                    string(name: 'DTP_URL', value: env.DTP_URL),
                    string(name: 'BUILD_ID', value: env.buildId),
                    string(name: 'CTP_ENV_ID', value: env.CTP_ENV_ID),
                    booleanParam(name: 'CI_DEBUG', value: params.CI_DEBUG),
                ]
            }
        }
        stage('Test: TIA Optimized UI Test Suite') {
            when { equals expected: true, actual: true }
            steps {
                script {
                    // Fetch impacted tests for this deployment from CTP
                    withCredentials([
                        usernamePassword(credentialsId: 'parasoft-demo-user', usernameVariable: 'PARASOFT_USER', passwordVariable: 'PARASOFT_PASS')
                    ]) {
                        sh '''
                            if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                            response=$(curl -sk -X 'GET' -u ${PARASOFT_USER}:${PARASOFT_PASS} -H 'accept: application/json' \
                                ${CTP_URL}/em/api/v3/environments/${CTP_ENV_ID}/coverage/impactedTests?baselineBuildId=${BASELINE_ID})
                            echo "$response"
                            echo "$response" > impactedTests.json
                        '''
                    }

                    def testNames = sh(script: '''jq -r '.[] | select(.analysisType == "FT") | .testName' impactedTests.json | paste -sd ',' -''', returnStdout: true).trim()
                    echo "${testNames}"

                    // Run each test module parameterized with impacted tests from CTP
                    // NOTE: JUnit 5 parallel execution is currently disabled.
                    // To re-enable parallel mode for selenium-tests and playwright-tests, add these flags back
                    // to their respective mvn commands AND set parasoft.coverage.integration.parallel.test.enabled=true
                    // in each module's coverage-integration.properties (or pass it as -D on the command line).
                    // Parallel execution requires the CTP coverage agents to be running in multi-user mode,
                    // otherwise concurrent tests cannot be distinguished by the agents:
                    //   -Djunit.jupiter.execution.parallel.enabled=true \
                    //   -Djunit.jupiter.execution.parallel.mode.classes.default=concurrent \
                    withCredentials([
                        usernamePassword(credentialsId: 'parasoft-demo-user', usernameVariable: 'PARASOFT_USER', passwordVariable: 'PARASOFT_PASS')
                    ]) {
                        withEnv(["TEST_NAMES=${testNames}"]) {
                            sh '''
                                echo "Running Selenium JUnit 5 module parameterized with impacted tests from CTP..."
                                if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                                mvn -ntp verify \
                                -pl spring-petclinic-selenium-tests \
                                -am \
                                -s './jtest/.m2/settings.xml' \
                                -Dorg.springframework.samples.petclinic.headless=true \
                                -DPETCLINIC_URL="http://${PUBLIC_IP}:8099" \
                                -Dparasoft.coverage.integration.ctp.url="${CTP_URL}/em" \
                                -Dparasoft.coverage.integration.ctp.envId=${CTP_ENV_ID} \
                                -Dparasoft.coverage.integration.ctp.auth.username=${PARASOFT_USER} \
                                -Dparasoft.coverage.integration.ctp.auth.password=${PARASOFT_PASS} \
                                -Dparasoft.coverage.integration.dtp.sessionTag=${app_name}-${buildId} \
                                -Dorg.slf4j.simpleLogger.log.com.parasoft.coverage.integration=${CI_LIB_LOG_LEVEL} \
                                -Dit.test="${TEST_NAMES}" \
                                -Dfailsafe.failIfNoSpecifiedTests=false
                            '''
                            sh '''
                                echo "Running Selenium JUnit5 + Cucumber module parameterized with impacted tests from CTP..."
                                if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                                mvn -ntp verify \
                                -pl spring-petclinic-selenium-cucumber-tests \
                                -am \
                                -s './jtest/.m2/settings.xml' \
                                -Dorg.springframework.samples.petclinic.headless=true \
                                -DPETCLINIC_URL="http://${PUBLIC_IP}:8099" \
                                -Dparasoft.coverage.integration.ctp.url="${CTP_URL}/em" \
                                -Dparasoft.coverage.integration.ctp.envId=${CTP_ENV_ID} \
                                -Dparasoft.coverage.integration.ctp.auth.username=${PARASOFT_USER} \
                                -Dparasoft.coverage.integration.ctp.auth.password=${PARASOFT_PASS} \
                                -Dparasoft.coverage.integration.dtp.sessionTag=${app_name}-${buildId} \
                                -DPROXY_HOST=${PRIVATE_IP} \
                                -DPROXY_BIND_HOST=${PRIVATE_IP} \
                                -Dorg.slf4j.simpleLogger.log.com.parasoft.coverage.integration=${CI_LIB_LOG_LEVEL} \
                                -Dit.test="${TEST_NAMES}" \
                                -Dfailsafe.failIfNoSpecifiedTests=false
                            '''
                            sh '''
                                echo "Running Selenium TestNG module parameterized with impacted tests from CTP..."
                                if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                                mvn -ntp verify \
                                -pl spring-petclinic-selenium-testng-tests \
                                -am \
                                -s './jtest/.m2/settings.xml' \
                                -Dorg.springframework.samples.petclinic.headless=true \
                                -DPETCLINIC_URL="http://${PUBLIC_IP}:8099" \
                                -Dparasoft.coverage.integration.ctp.url="${CTP_URL}/em" \
                                -Dparasoft.coverage.integration.ctp.envId=${CTP_ENV_ID} \
                                -Dparasoft.coverage.integration.ctp.auth.username=${PARASOFT_USER} \
                                -Dparasoft.coverage.integration.ctp.auth.password=${PARASOFT_PASS} \
                                -Dparasoft.coverage.integration.dtp.sessionTag=${app_name}-${buildId} \
                                -Dorg.slf4j.simpleLogger.log.com.parasoft.coverage.integration=${CI_LIB_LOG_LEVEL} \
                                -Dit.test="${TEST_NAMES}" \
                                -Dfailsafe.failIfNoSpecifiedTests=false
                            '''
                            sh '''
                                echo "Running Playwright JUnit 5 module parameterized with impacted tests from CTP..."
                                if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                                mvn -ntp verify \
                                -pl spring-petclinic-playwright-tests \
                                -am \
                                -s './jtest/.m2/settings.xml' \
                                -Dorg.springframework.samples.petclinic.headless=true \
                                -DPETCLINIC_URL="http://${PUBLIC_IP}:8099" \
                                -Dparasoft.coverage.integration.ctp.url="${CTP_URL}/em" \
                                -Dparasoft.coverage.integration.ctp.envId=${CTP_ENV_ID} \
                                -Dparasoft.coverage.integration.ctp.auth.username=${PARASOFT_USER} \
                                -Dparasoft.coverage.integration.ctp.auth.password=${PARASOFT_PASS} \
                                -Dparasoft.coverage.integration.dtp.sessionTag=${app_name}-${buildId} \
                                -Dorg.slf4j.simpleLogger.log.com.parasoft.coverage.integration=${CI_LIB_LOG_LEVEL} \
                                -Dit.test="${TEST_NAMES}" \
                                -Dfailsafe.failIfNoSpecifiedTests=false
                            '''
                            sh '''
                                echo "Running Selenium JUnit 4 module parameterized with impacted tests from CTP..."
                                if [ "${CI_DEBUG}" != "true" ]; then set +x; else set -x; fi
                                mvn -ntp verify \
                                -pl spring-petclinic-selenium-junit4-tests \
                                -am \
                                -s './jtest/.m2/settings.xml' \
                                -Dorg.springframework.samples.petclinic.headless=true \
                                -DPETCLINIC_URL="http://${PUBLIC_IP}:8099" \
                                -Dparasoft.coverage.integration.ctp.url="${CTP_URL}/em" \
                                -Dparasoft.coverage.integration.ctp.envId=${CTP_ENV_ID} \
                                -Dparasoft.coverage.integration.ctp.auth.username=${PARASOFT_USER} \
                                -Dparasoft.coverage.integration.ctp.auth.password=${PARASOFT_PASS} \
                                -Dparasoft.coverage.integration.dtp.sessionTag=${app_name}-${buildId} \
                                -DPROXY_HOST=${PRIVATE_IP} \
                                -DPROXY_BIND_HOST=${PRIVATE_IP} \
                                -Dorg.slf4j.simpleLogger.log.com.parasoft.coverage.integration=${CI_LIB_LOG_LEVEL} \
                                -Dit.test="${TEST_NAMES}" \
                                -Dfailsafe.failIfNoSpecifiedTests=false
                            '''
                        }
                    }
                }
            }
        }
        stage('Release') {
            steps {
                sh 'echo "Release"'
                //copyArtifacts(projectName: 'master/Petclinic-build', selector: lastSuccessful())
                //copyArtifacts(projectName: 'master/Petclinic-jtest', selector: lastSuccessful())
                //recordParasoftCoverage pattern: '**/target/jtest/ut/coverage.xml'
            }
        }
    }
    post {
        // Clean after build
        always {
            sh '''
                docker container stop selenium-grid || true
                docker container prune -f
                docker image prune -f
                echo "cleaning up..."
                # rm -rf "jtest_agent"
                # rm -rf "jtestcov"
            '''
        }
    }
}