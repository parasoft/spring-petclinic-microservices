pipeline {
    agent any
    tools {
        maven 'maven'
        jdk 'JDK 17'
    }
    options {
        // This is required if you want to clean before build
        skipDefaultCheckout(true)

        // Set a timeout for the entire pipeline
        timeout(time: 20, unit: 'MINUTES')

        // Only keep 5 jobs history and 2 jobs artifacts
        buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '2'))
    }
    parameters {
        string(name: 'CTP_URL', description: 'Parasoft CTP URL')
        string(name: 'DTP_URL', description: 'Parasoft DTP URL')
        string(name: 'DTP_USER', description: 'Parasoft DTP Username')
        password(name: 'DTP_PASS', description: 'Parasoft DTP Password')
        string(name: 'BUILD_TIMESTAMP', description: 'DTP Build Id')
        string(name: 'CTP_ENV_ID', description: 'Parasoft CTP Environment ID')
        string(name: 'CTP_DEBUG', defaultValue: 'false', description: 'Enable debug logging for Jenkins pipeline')
    }
    environment {
        // App Settings
        app_name = 'spring-petclinic-microservices' // top level DTP Project
    }

    stages {
        stage('Deploy: Set Up') {
            steps {
                // Clean before build
                cleanWs()

                // Checkout project
                checkout scm

                // Normalize URLs and resolve agent GID
                script {
                    env.CTP_URL = params.CTP_URL.replaceAll('/+$', '')
                    env.DTP_URL = params.DTP_URL.replaceAll('/+$', '')
                    env.GID     = sh(script: 'id -g jenkins', returnStdout: true).trim()
                }

                // Download coverage agent archive from CTP
                withEnv(["CTP_URL=${env.CTP_URL}"]) {
                    sh '''
                        if [ "${CTP_DEBUG}" != "true" ]; then
                            set +x
                        fi
                        curl -kLO -u ${DTP_USER}:${DTP_PASS} ${CTP_URL}/em/coverageagent/java_agent_coverage.zip
                        if [ "${CTP_DEBUG}" != "true" ]; then
                            set -x
                        fi
                        unzip java_agent_coverage.zip
                    '''
                }
                
                // Copy coverage agent JARs into each microservice
                sh '''
                    for service in spring-petclinic-api-gateway spring-petclinic-vets-service spring-petclinic-visits-service spring-petclinic-customers-service; do
                        cp jtest_agent/agent.jar                   ${service}/src/test/resources/coverage/agent.jar
                        cp jtest_agent/jtest-otel-ext.jar          ${service}/src/test/resources/coverage/jtest-otel-ext.jar
                        cp jtest_agent/opentelemetry-javaagent.jar ${service}/src/test/resources/coverage/opentelemetry-javaagent.jar
                    done
                '''

                // Patch agent.properties with CTP and DTP configuration
                script {
                    def ctpUrl         = env.CTP_URL
                    def dtpUrl         = env.DTP_URL
                    def appName        = env.app_name
                    def buildTimestamp = params.BUILD_TIMESTAMP

                    withEnv(["CTP_URL=${ctpUrl}", "DTP_URL=${dtpUrl}"]) {
                        // Fetch all components for this CTP environment
                        def componentsResponse = sh(
                            script: '''
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set +x
                                fi
                                curl -sk -u "${DTP_USER}:${DTP_PASS}" \
                                    -H 'accept: application/json' \
                                    "${CTP_URL}/em/api/v3/environments/${CTP_ENV_ID}/components"
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set -x
                                fi
                            ''',
                            returnStdout: true
                        ).trim()
                        if (params.CTP_DEBUG == 'true') {
                            echo "CTP components response:\n${componentsResponse}"
                        }
                        def componentsJson = new groovy.json.JsonSlurperClassic().parseText(componentsResponse)

                        // Resolve DTP filter ID by app name
                        def filterResponse = sh(
                            script: '''
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set +x
                                fi
                                curl -sk -u "${DTP_USER}:${DTP_PASS}" \
                                    -H 'accept: application/json' \
                                    "${DTP_URL}/grs/api/v1.12/filters?managedOnly=false&name=${app_name}"
                                if [ "${CTP_DEBUG}" != "true" ]; then
                                    set -x
                                fi
                            ''',
                            returnStdout: true
                        ).trim()
                        if (params.CTP_DEBUG == 'true') {
                            echo "DTP filter response:\n${filterResponse}"
                        }
                        def filterJson = new groovy.json.JsonSlurperClassic().parseText(filterResponse)
                        def filterId = filterJson[0]?.id
                        if (!filterId) {
                            error("Could not resolve DTP filter ID for '${appName}'")
                        }
                        echo "Resolved DTP filter ID: ${filterId}"

                        // Map service directory -> CTP component name
                        def serviceConfigs = [
                            [dir: 'spring-petclinic-api-gateway',       ctpName: 'UI + API Gateway'],
                            [dir: 'spring-petclinic-customers-service',  ctpName: 'customers-service REST API'],
                            [dir: 'spring-petclinic-vets-service',       ctpName: 'vets-service REST API'],
                            [dir: 'spring-petclinic-visits-service',     ctpName: 'visits-service REST API']
                        ]

                        for (serviceConfig in serviceConfigs) {
                            def serviceDir = serviceConfig.dir
                            def ctpName    = serviceConfig.ctpName
                            def component  = componentsJson.components.find { it.name == ctpName }
                            if (!component) {
                                error("Could not find CTP component named '${ctpName}'")
                            }
                            def wsUrl     = component.ctpWebsocketUrl
                            def subQueue  = component.ctpSubscriptionQueue
                            def propsFile = "${serviceDir}/src/test/resources/coverage/agent.properties"

                            withEnv(["PROPS_FILE=${propsFile}", "WS_URL=${wsUrl}", "SUB_QUEUE=${subQueue}", "FILTER_ID=${filterId}", "BUILD_TIMESTAMP=${buildTimestamp}"]) {
                                sh '''
                                    sed -i "s|^ctp.websocket.url=.*|ctp.websocket.url=${WS_URL}|" "${PROPS_FILE}"
                                    sed -i "s|^ctp.subscription.queue=.*|ctp.subscription.queue=${SUB_QUEUE}|" "${PROPS_FILE}"
                                    sed -i "s|^dtp.buildID=.*|dtp.buildID=${app_name}-${BUILD_TIMESTAMP}|" "${PROPS_FILE}"
                                    sed -i "s|^dtp.project=.*|dtp.project=${app_name}|" "${PROPS_FILE}"
                                    sed -i "s|^dtp.coverageImages=.*|dtp.coverageImages=${app_name};${app_name}-FT|" "${PROPS_FILE}"
                                    sed -i "s|^dtp.filterID=.*|dtp.filterID=${FILTER_ID}|" "${PROPS_FILE}"
                                '''
                                echo "Patched ${propsFile}"
                                if (params.CTP_DEBUG == 'true') {
                                    sh 'cat "${PROPS_FILE}"'
                                }
                            }
                        }
                    }
                }
            }
        }
        stage('Deploy: Launch Services') {
            when { equals expected: true, actual: true }
            steps {
                // check running containers
                sh '''
                    docker-compose -f docker-compose-cc.yml down || true
                    sleep 10s
                    '''
                // deploy the project
                sh  '''
                    # Run PetClinic with Jtest coverage agent and load balancer configured
                    docker-compose -f docker-compose-cc-lb.yml up -d --force-recreate

                    # Allow containers to settle before polling
                    sleep 150s

                    echo "Waiting for owners API to be ready..."
                    attempts=30
                    sleep_seconds=10
                    i=1
                    while [ $i -le $attempts ]; do
                        http_code=$(curl -s --max-time 5 -o owners.json -w "%{http_code}" http://localhost:8099/api/customer/owners || true)
                        if [ "$http_code" = "200" ] && jq -e 'type=="array" and length>0' owners.json > /dev/null 2>&1; then
                            echo "Owners API ready."
                            break
                        fi
                        echo "Owners API not ready (attempt $i/$attempts, status $http_code)."
                        i=$((i+1))
                        sleep $sleep_seconds
                    done
                    if [ $i -gt $attempts ]; then
                        echo "Owners API did not become ready in time."
                        cat owners.json
                        exit 1
                    fi
                    '''
                // Health check all 8 coverage agents (2 instances x 4 services)
                sh '''
                    for port in 8051 8052 8053 8054 8055 8056 8057 8058; do
                        echo "Coverage agent on port ${port}:"
                        curl -iv --raw http://localhost:${port}/status
                    done
                    '''
            }
        }
    }
    post {
        always {
            sh  '''
                echo "cleaning up..."
                rm -rf "jtest_agent"
                rm -rf "jtestcov"

                '''
        }
    }
}
